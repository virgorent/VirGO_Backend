{
  "collection": "passwordResets",
  "validationLevel": "strict",
  "validationAction": "error",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "passwordResets",
      "required": [
        "_id",
        "userId",
        "expiresAt",
        "codeHash",
        "attempts"
      ],
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "userId": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expiresAt": {
          "bsonType": "date"
        },
        "codeHash": {
          "bsonType": "string",
          "maxLength": 255
        },
        "attempts": {
          "bsonType": "int",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  },
  "indexes": [
    {
      "name": "userId_1_unique",
      "key": {
        "userId": 1
      },
      "options": {
        "unique": true
      }
    },
    {
      "name": "expiresAt_ttl",
      "key": {
        "expiresAt": 1
      },
      "options": {
        "expireAfterSeconds": 0
      }
    }
  ]
}
