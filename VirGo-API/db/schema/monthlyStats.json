{
  "collection": "monthlyStats",
  "validationLevel": "strict",
  "validationAction": "error",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "monthlyStats",
      "required": [
        "_id",
        "targetType",
        "targetId",
        "month",
        "visits",
        "requests",
        "bookings"
      ],
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^(venue|provider):[0-9a-fA-F-]{36}:[0-9]{4}-[0-9]{2}$",
          "description": "Determinista: <targetType>:<targetId>:<AAAA-MM>, para que el upsert con $inc funcione"
        },
        "targetType": {
          "bsonType": "string",
          "enum": [
            "venue",
            "provider"
          ]
        },
        "targetId": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "month": {
          "bsonType": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "visits": {
          "bsonType": "int",
          "minimum": 0
        },
        "requests": {
          "bsonType": "int",
          "minimum": 0
        },
        "bookings": {
          "bsonType": "int",
          "minimum": 0
        }
      }
    }
  },
  "indexes": [
    {
      "name": "targetType_1_targetId_1_month_1_unique",
      "key": {
        "targetType": 1,
        "targetId": 1,
        "month": 1
      },
      "options": {
        "unique": true
      }
    }
  ]
}
