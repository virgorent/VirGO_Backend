        },
        "eventId": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "title": {
          "bsonType": "string",
          "maxLength": 150
        },
        "dueDate": {
          "bsonType": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "done": {
          "bsonType": "bool"
        },
        "suggested": {
          "bsonType": "bool"
        }
      }
