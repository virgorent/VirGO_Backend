{
  "collection": "venueDates",
  "validationLevel": "strict",
  "validationAction": "error",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "venueDates",
      "required": [
        "_id",
        "venueId",
        "date",
        "kind"
      ],
      "properties": {
        "_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "venueId": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "date": {
          "bsonType": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "kind": {
          "bsonType": "string",
          "enum": [
            "blocked",
            "booked"
          ]
        },
        "reason": {
          "bsonType": "string",
          "enum": [
            "maintenance",
            "own_event",
            "other"
          ]
        },
        "note": {
          "bsonType": "string",
          "maxLength": 200
        },
        "bookingId": {
          "bsonType": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    }
  },
  "indexes": [
    {
      "name": "venueId_1_date_1_unique",
      "key": {
        "venueId": 1,
        "date": 1
      },
      "options": {
        "unique": true
      }
    }
  ]
}
