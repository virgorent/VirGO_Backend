{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    "Provider": "InMemory",
    "DatabaseName": "virgo_dev"
  },
  "Jwt": {
    "Issuer": "VirGo.Api",
    "Audience": "VirGo.Mobile",
    "SigningKey": "DevelopmentOnlySigningKeyNotASecret123456789"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 20,
    "WindowSeconds": 1
  },
  "Authentication": {
    "DemoEmail": "demo@virgo.mx",
    "DemoPassword": "VirGo-local-only-password"
  }
}
